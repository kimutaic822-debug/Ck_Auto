{
  "appId": "com.ckauto.app",
  "appName": "CK Auto",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#121212"
    },
    "ForegroundService": {
      "smallIcon": "ic_stat_ck",
      "largeIcon": "ic_launcher_foreground"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_ck",
      "iconColor": "#4caf50"
    }
  }
}
